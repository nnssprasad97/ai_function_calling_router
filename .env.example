# Environment configuration for AI Function-Calling Router
# Real keys stay local; do not commit actual API keys.

# Optional: If provided, router can use hosted OpenAI API.
# If omitted or empty, router defaults to deterministic built-in offline simulation engine.
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL_ID=gpt-4o-mini

# Router configuration
BACKOFF_DURATION_SECONDS=0.1
MAX_RECOVERY_RETRIES=1
LOG_LEVEL=INFO
